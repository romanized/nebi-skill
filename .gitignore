# Never commit anything machine-specific or sensitive.
# This repo holds ONLY the portable nebi setup (claude-home/ + deploy scripts).
# The real ~/.claude/settings.json (with permissions/tokens) is NOT part of this repo.

# settings backups the deploy script writes
*.nebi-bak
settings.json
settings.local.json

# machine-specific removal logs (regenerated per machine, not portable)
claude-home/nebi/removed-skills-*.txt

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
node_modules/

# raw social/web pulls from discovery passes (third-party content; digests are committed instead)
research/*/raw/

# Python bytecode caches
__pycache__/

# Claude Code session state
.claude/scheduled_tasks.lock
.claude/worktrees/

# per-project browser route: names this machine's Chrome profile and device
.claude/browser.json
